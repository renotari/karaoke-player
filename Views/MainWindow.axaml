<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KaraokePlayer.ViewModels"
        xmlns:views="using:KaraokePlayer.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="KaraokePlayer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Karaoke Player"
        Width="1200"
        Height="700"
        MinWidth="800"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <vm:SecondsToTimeConverter x:Key="SecondsToTime"/>

        <!-- Playback bar icons (Material Design Icons, Apache 2.0): vector shapes
             look the same on every PC, unlike emoji symbols -->
        <StreamGeometry x:Key="IconPrevious">M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z</StreamGeometry>
        <StreamGeometry x:Key="IconNext">M16,18H18V6H16M6,18L14.5,12L6,6V18Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="IconStop">M18,18H6V6H18V18Z</StreamGeometry>
        <StreamGeometry x:Key="IconVolume">M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z</StreamGeometry>
        <StreamGeometry x:Key="IconMuted">M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z</StreamGeometry>
        <StreamGeometry x:Key="IconVideoMode">M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Focus indicator styles for keyboard navigation -->
        <Style Selector="Button:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="ListBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="ListBoxItem:focus">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
        </Style>
        
        <!-- Playback bar: round, flat buttons; Play/Pause larger and in the accent color -->
        <Style Selector="Button.transport">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.transport PathIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>
        <Style Selector="Button.transport.primary">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.transport.primary PathIcon">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Button.transport.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.transport.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.transport:disabled PathIcon">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Drag and drop in the playlist: where the song will land -->
        <Style Selector="ListBox#PlaylistListBox ListBoxItem.dropAbove">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="0,3,0,0"/>
        </Style>
        <Style Selector="ListBox#PlaylistListBox ListBoxItem.dropBelow">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
        </Style>

        <Style Selector="Slider:focus /template/ Thumb">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Styles>

    <!-- Root Panel to hold both main content and toast notifications -->
    <Panel>
        <!-- Main Content Grid -->
        <Grid RowDefinitions="Auto,*,Auto,Auto">
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0" IsVisible="{Binding ShowWindowChrome}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Media Directory..." Command="{Binding OpenMediaDirectoryCommand}" />
                <MenuItem Header="_Refresh Library" Command="{Binding RefreshLibraryCommand}" InputGesture="Ctrl+R" />
                <MenuItem Header="Download from _YouTube..." Command="{Binding OpenYouTubeCommand}" InputGesture="Ctrl+T" />
                <Separator />
                <MenuItem Header="Playlist _Composer..." Command="{Binding OpenPlaylistComposerCommand}" InputGesture="Ctrl+P" />
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle Video Mode" Command="{Binding ToggleVideoModeCommand}" />
                <MenuItem Header="_Fullscreen" Command="{Binding ToggleFullscreenCommand}" InputGesture="F11" />
                <Separator />
                <MenuItem Header="_Single Screen Mode" Command="{Binding SetSingleScreenModeCommand}" />
                <MenuItem Header="_Dual Screen Mode" Command="{Binding SetDualScreenModeCommand}" InputGesture="Ctrl+D" />
            </MenuItem>
            <MenuItem Header="_Playback">
                <MenuItem Header="_Play/Pause" Command="{Binding PlayPauseCommand}" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" />
                <MenuItem Header="_Next" Command="{Binding NextCommand}" />
                <MenuItem Header="_Previous" Command="{Binding PreviousCommand}" />
                <Separator />
                <MenuItem Header="S_ubtitles" ToggleType="CheckBox" IsChecked="{Binding SubtitlesEnabled}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Preferences..." Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Main Content Area - Normal Mode (Three Panes) -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnDefinitions="300,5,*,5,300">
            
            <!-- Left Pane: Media Catalog with Search -->
            <Border Grid.Column="0"
                    IsVisible="{Binding !IsVideoMode}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                    BorderThickness="0,0,1,0"
                    Padding="8">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    
                    <!-- Search Bar -->
                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="0"
                             Watermark="Search by artist, title, or filename..."
                             Margin="0,0,0,8"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             TabIndex="0"
                             IsTabStop="True">
                        <TextBox.InnerRightContent>
                            <Button Content="✕" 
                                    IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Command="{Binding ClearSearchCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    TabIndex="1"/>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Song missing from the library: look for it on YouTube -->
                    <Button Grid.Row="1"
                            Content="Not here? Search on YouTube"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,0,8"
                            IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding OpenYouTubeCommand}"
                            ToolTip.Tip="Download the song from YouTube (Ctrl+T)"/>

                    <!-- Catalog Header -->
                    <TextBlock Grid.Row="2" 
                               Text="Media Catalog"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               IsTabStop="False"/>

                    <!-- Media Catalog List with Virtualization (enabled by default in Avalonia) -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding FilteredMediaFiles}"
                             DoubleTapped="OnCatalogDoubleTapped"
                             SelectedItem="{Binding SelectedMediaFile}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TabIndex="2"
                             IsTabStop="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80,*" 
                                      Margin="4"
                                      Background="Transparent">
                                    
                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" 
                                            Width="80" 
                                            Height="60"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                        <Panel>
                                            <Image Source="{Binding ThumbnailPath, Converter={x:Static vm:ThumbnailConverter.Instance}}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding ThumbnailLoaded}"/>
                                            <TextBlock Text="🎵"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !ThumbnailLoaded}"/>
                                        </Panel>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="1" 
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayArtist}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding DisplayArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                        <TextBlock Text="{Binding Metadata.Duration, Converter={StaticResource SecondsToTime}, FallbackValue=''}"
                                                   IsVisible="{Binding MetadataLoaded}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <!-- Context Menu -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add to Playlist (Next)" 
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).AddToPlaylistNextCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Add to Playlist (End)" 
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).AddToPlaylistEndCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Grid Splitter (Left) -->
            <GridSplitter Grid.Column="1"
                          IsVisible="{Binding !IsVideoMode}"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

            <!-- Center Pane: Video Output Area (also used, alone, in Video Mode) -->
            <Border Grid.Column="2"
                    Background="Black"
                    Padding="0">
                <Grid RowDefinitions="*,Auto">
                    <Grid Grid.Row="0" Background="Black" RowDefinitions="*,Auto">
                        <!-- Waiting screen (nothing playing) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsVisible="{Binding IsIdle}">
                            <TextBlock Text="🎤"
                                       FontSize="64"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Waiting for the next song"
                                       Foreground="White"
                                       FontSize="24"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding NextSongInfo, StringFormat='Up next: {0}'}"
                                       Foreground="#CCFFFFFF"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsVisible="{Binding HasNextSong}"/>
                        </StackPanel>

                        <!-- Now playing (audio files) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    Margin="24"
                                    IsVisible="{Binding ShowAudioInfoPanel}">
                            <TextBlock Text="🎵"
                                       FontSize="64"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue=''}"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=''}"
                                       Foreground="#CCFFFFFF"
                                       FontSize="22"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Dual screen: the video is on the playback window -->
                        <Border Background="Black" IsVisible="{Binding IsDualScreenMode}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Margin="24">
                                <TextBlock Text="📺" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="Video is on the second screen"
                                           Foreground="White"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentSongInfo}"
                                           Foreground="#CCFFFFFF"
                                           FontSize="16"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NextSongInfo, StringFormat='Up next: {0}'}"
                                           Foreground="#99FFFFFF"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding HasNextSong}"/>
                                <Button Content="Back to single screen"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Command="{Binding SetSingleScreenModeCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Video surfaces: one native window per LibVLC player (crossfade uses
                             both). They are always in the visual tree so their native handles
                             exist before playback starts; only the active one is visible.
                             Avalonia controls cannot be drawn on top of them. -->
                        <views:EmbeddedVideoView x:Name="VideoViewA"
                                                 IsVisible="{Binding IsVideoSurfaceAVisible}"/>
                        <views:EmbeddedVideoView x:Name="VideoViewB"
                                                 IsVisible="{Binding IsVideoSurfaceBVisible}"/>
                        <!-- Audio with visualization: title under the native surface -->
                        <Border Grid.Row="1" Background="Black" Padding="12,8"
                                IsVisible="{Binding ShowAudioTitleStrip}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue=''}"
                                           Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=''}"
                                           Foreground="#CCFFFFFF" FontSize="16" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Collapsible Control Handle at Bottom -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsVideoMode}">
                        <!-- Collapsed Handle (Small Bar) -->
                        <Border x:Name="CollapsedHandle"
                                Height="30"
                                Background="#80000000"
                                IsVisible="{Binding !IsControlHandleExpanded}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock Text="▲"
                                           Foreground="White"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Quick Search &amp; Controls"
                                           Foreground="White"
                                           FontSize="12"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Expanded Handle (Full Controls) -->
                        <Border x:Name="ExpandedHandle"
                                Background="#E8101010"
                                IsVisible="{Binding IsControlHandleExpanded}"
                                Padding="16,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,16,*">

                                <!-- Header -->
                                <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="Quick Search" Foreground="White"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="⬇ YouTube" Margin="0,0,8,0"
                                            ToolTip.Tip="Search and download the song from YouTube"
                                            Command="{Binding OpenYouTubeCommand}"/>
                                    <Button Grid.Column="2" Content="⚙ Settings" Margin="0,0,8,0"
                                            Command="{Binding OpenSettingsCommand}"/>
                                    <Button Grid.Column="3" Content="Exit Video Mode" Margin="0,0,8,0"
                                            Command="{Binding ToggleVideoModeCommand}"/>
                                    <Button Grid.Column="4" Content="▼ Collapse"
                                            Command="{Binding CollapseControlHandleCommand}"/>
                                </Grid>

                                <!-- Search box: same query as the catalog search -->
                                <TextBox x:Name="QuickSearchTextBox"
                                         Grid.Row="1" Grid.Column="0"
                                         Watermark="Artist, title or file name... (double-click a result: plays next)"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding CurrentPlaylist.Count, StringFormat='Playlist ({0})'}"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Results -->
                                <ListBox Grid.Row="2" Grid.Column="0"
                                         Height="200"
                                         ItemsSource="{Binding FilteredMediaFiles}"
                                         SelectedItem="{Binding SelectedMediaFile}"
                                         DoubleTapped="OnCatalogDoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" Background="Transparent">
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Next" Padding="8,2" Margin="8,0,4,0"
                                                        ToolTip.Tip="Play after the current song"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).AddToPlaylistNextCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2" Content="End" Padding="8,2"
                                                        ToolTip.Tip="Add to the end of the playlist"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).AddToPlaylistEndCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Compact playlist -->
                                <ListBox Grid.Row="2" Grid.Column="2"
                                         Height="200"
                                         ItemsSource="{Binding CurrentPlaylist}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                                                <Panel Grid.Column="0" MinWidth="22" Margin="0,0,6,0">
                                                    <TextBlock Text="▶" Foreground="Green" IsVisible="{Binding IsCurrentlyPlaying}"/>
                                                    <TextBlock Text="{Binding PlaylistItem.Position, Converter={x:Static vm:PlusOneConverter.Instance}}"
                                                               IsVisible="{Binding !IsCurrentlyPlaying}"/>
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding MediaFile.DisplayName}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Content="✕" Padding="6,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="Remove from playlist"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RemoveSongCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Grid Splitter (Right) -->
            <GridSplitter Grid.Column="3"
                          IsVisible="{Binding !IsVideoMode}"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

            <!-- Right Pane: Current Playlist -->
            <Border Grid.Column="4"
                    IsVisible="{Binding !IsVideoMode}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                    BorderThickness="1,0,0,0"
                    Padding="8">
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- Playlist Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Current Playlist"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPlaylist.Count, StringFormat=' ({0})'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>

                    <!-- Playlist items: drag to reorder (MainWindow.PlaylistDrag.cs) -->
                    <ListBox Grid.Row="1"
                             x:Name="PlaylistListBox"
                             ItemsSource="{Binding CurrentPlaylist}"
                             DoubleTapped="OnPlaylistDoubleTapped"
                             SelectedItem="{Binding SelectedPlaylistItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TabIndex="3"
                             IsTabStop="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,80,*,Auto" 
                                      Margin="4"
                                      Background="Transparent">

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Play now"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaySongNowCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Play next"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaySongNextCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Move up"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).MoveSongUpCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Move down"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).MoveSongDownCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Remove"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RemoveSongCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Queue position (▶ for the song playing) -->
                                    <Panel Grid.Column="0" MinWidth="22" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="▶"
                                                   Foreground="Green"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding IsCurrentlyPlaying}"/>
                                        <TextBlock Text="{Binding PlaylistItem.Position, Converter={x:Static vm:PlusOneConverter.Instance}}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   IsVisible="{Binding !IsCurrentlyPlaying}"/>
                                    </Panel>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="1" 
                                            Width="60" 
                                            Height="45"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                        <Panel>
                                            <Image Source="{Binding MediaFile.ThumbnailPath, Converter={x:Static vm:ThumbnailConverter.Instance}}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding MediaFile.ThumbnailLoaded}"/>
                                            <TextBlock Text="🎵"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !MediaFile.ThumbnailLoaded}"/>
                                        </Panel>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="2" 
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MediaFile.DisplayArtist}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding MediaFile.DisplayArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding MediaFile.DisplayTitle}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                        
                                        <!-- Indicators -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="▶ Now Playing"
                                                       FontSize="10"
                                                       Foreground="Green"
                                                       IsVisible="{Binding IsCurrentlyPlaying}"/>
                                            <TextBlock Text="✕ Error"
                                                       FontSize="10"
                                                       Foreground="Red"
                                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Remove Button -->
                                    <Button Grid.Column="3"
                                            Content="✕"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RemoveSongCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            ToolTip.Tip="Remove from playlist"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Playlist Actions -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                Spacing="4"
                                Margin="0,8,0,0">
                        <Button Content="Clear"
                                Command="{Binding ClearPlaylistCommand}"
                                ToolTip.Tip="Clear all songs from playlist"
                                TabIndex="4"/>
                        <Button Content="Shuffle"
                                Command="{Binding ShufflePlaylistCommand}"
                                ToolTip.Tip="Shuffle playlist order"
                                TabIndex="5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Playback Controls -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowWindowChrome}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Transport Controls -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="transport"
                            Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Previous (Left Arrow)"
                            TabIndex="10">
                        <PathIcon Data="{StaticResource IconPrevious}"/>
                    </Button>
                    <Button Classes="transport primary"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip.Tip="Play/Pause (Space)"
                            TabIndex="11">
                        <Panel>
                            <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding !IsPlaying}"/>
                            <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding IsPlaying}"/>
                        </Panel>
                    </Button>
                    <Button Classes="transport"
                            Command="{Binding NextCommand}"
                            ToolTip.Tip="Next (Right Arrow)"
                            TabIndex="12">
                        <PathIcon Data="{StaticResource IconNext}"/>
                    </Button>
                    <Button Classes="transport"
                            Command="{Binding StopCommand}"
                            ToolTip.Tip="Stop (S)"
                            TabIndex="13">
                        <PathIcon Data="{StaticResource IconStop}"/>
                    </Button>
                </StackPanel>

                <!-- Progress Bar and Time -->
                <StackPanel Grid.Column="1" 
                            Margin="16,0"
                            VerticalAlignment="Center">
                    <Slider Value="{Binding CurrentTime}"
                            Minimum="0"
                            Maximum="{Binding Duration}"
                            IsEnabled="{Binding !IsIdle}"
                            ToolTip.Tip="Click or drag to move within the song"
                            Margin="0,0,0,4"
                            TabIndex="14"
                            IsTabStop="True"/>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding CurrentTime, Converter={StaticResource SecondsToTime}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Duration, Converter={StaticResource SecondsToTime}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Volume Control -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="transport"
                            ToolTip.Tip="Video Mode on/off (Esc to exit)"
                            Command="{Binding ToggleVideoModeCommand}"
                            TabIndex="14">
                        <PathIcon Data="{StaticResource IconVideoMode}"/>
                    </Button>
                    <Button Classes="transport"
                            ToolTip.Tip="Mute/Unmute (M)"
                            Command="{Binding ToggleMuteCommand}"
                            TabIndex="15">
                        <Panel>
                            <PathIcon Data="{StaticResource IconVolume}" IsVisible="{Binding !IsSilent}"/>
                            <PathIcon Data="{StaticResource IconMuted}" IsVisible="{Binding IsSilent}"/>
                        </Panel>
                    </Button>
                    <Slider Value="{Binding Volume}"
                            Minimum="0"
                            Maximum="100"
                            Width="100"
                            VerticalAlignment="Center"
                            TabIndex="16"
                            IsTabStop="True"
                            ToolTip.Tip="Volume (Up/Down Arrows)"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}"
                               VerticalAlignment="Center"
                               MinWidth="40"
                               FontSize="11"
                               IsTabStop="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                IsVisible="{Binding ShowWindowChrome}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="0,1,0,0"
                Padding="16,4"
                Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding CurrentSongInfo}"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding DownloadStatus}"
                            IsVisible="{Binding HasDownloadStatus}"
                            Command="{Binding OpenYouTubeCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,0"
                            FontSize="12"
                            MaxWidth="400"
                            ToolTip.Tip="YouTube downloads (click to open)"/>
                    <TextBlock Text="🔀"
                               IsVisible="{Binding ShuffleEnabled}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Shuffle enabled"/>
                    <TextBlock Text="🔁"
                               IsVisible="{Binding CrossfadeEnabled}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Crossfade enabled"/>
                    <TextBlock Text="{Binding MediaLibraryCount, StringFormat='📁 {0} files'}"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- Toast Notification Container (Overlay at bottom-right) -->
        <ItemsControl ItemsSource="{Binding NotificationService.Notifications}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,16,80">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:ToastNotificationControl NotificationService="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NotificationService}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>

</Window>
