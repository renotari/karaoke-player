<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KaraokePlayer.ViewModels"
        xmlns:views="using:KaraokePlayer.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="KaraokePlayer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Karaoke Player"
        Width="1200"
        Height="700"
        MinWidth="800"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <vm:PlayPauseConverter x:Key="PlayPauseConverter"/>
        <vm:SecondsToTimeConverter x:Key="SecondsToTime"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Focus indicator styles for keyboard navigation -->
        <Style Selector="Button:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="ListBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="ListBoxItem:focus">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
        </Style>
        
        <Style Selector="Slider:focus /template/ Thumb">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Styles>

    <!-- Root Panel to hold both main content and toast notifications -->
    <Panel>
        <!-- Main Content Grid -->
        <Grid RowDefinitions="Auto,*,Auto,Auto">
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0" IsVisible="{Binding ShowWindowChrome}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Media Directory..." Command="{Binding OpenMediaDirectoryCommand}" />
                <MenuItem Header="_Refresh Library" Command="{Binding RefreshLibraryCommand}" InputGesture="Ctrl+R" />
                <Separator />
                <MenuItem Header="Playlist _Composer..." Command="{Binding OpenPlaylistComposerCommand}" InputGesture="Ctrl+P" />
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle Video Mode" Command="{Binding ToggleVideoModeCommand}" />
                <MenuItem Header="_Fullscreen" Command="{Binding ToggleFullscreenCommand}" InputGesture="F11" />
                <Separator />
                <MenuItem Header="_Single Screen Mode" Command="{Binding SetSingleScreenModeCommand}" />
                <MenuItem Header="_Dual Screen Mode" Command="{Binding SetDualScreenModeCommand}" InputGesture="Ctrl+D" />
            </MenuItem>
            <MenuItem Header="_Playback">
                <MenuItem Header="_Play/Pause" Command="{Binding PlayPauseCommand}" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" />
                <MenuItem Header="_Next" Command="{Binding NextCommand}" />
                <MenuItem Header="_Previous" Command="{Binding PreviousCommand}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Preferences..." Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Main Content Area - Normal Mode (Three Panes) -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnDefinitions="300,5,*,5,300">
            
            <!-- Left Pane: Media Catalog with Search -->
            <Border Grid.Column="0"
                    IsVisible="{Binding !IsVideoMode}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                    BorderThickness="0,0,1,0"
                    Padding="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    
                    <!-- Search Bar -->
                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="0"
                             Watermark="Search by artist, title, or filename..."
                             Margin="0,0,0,8"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             TabIndex="0"
                             IsTabStop="True">
                        <TextBox.InnerRightContent>
                            <Button Content="✕" 
                                    IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Command="{Binding ClearSearchCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    TabIndex="1"/>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Catalog Header -->
                    <TextBlock Grid.Row="1" 
                               Text="Media Catalog"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               IsTabStop="False"/>

                    <!-- Media Catalog List with Virtualization (enabled by default in Avalonia) -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredMediaFiles}"
                             DoubleTapped="OnCatalogDoubleTapped"
                             SelectedItem="{Binding SelectedMediaFile}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TabIndex="2"
                             IsTabStop="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80,*" 
                                      Margin="4"
                                      Background="Transparent">
                                    
                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" 
                                            Width="80" 
                                            Height="60"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                        <Panel>
                                            <Image Source="{Binding ThumbnailPath, Converter={x:Static vm:ThumbnailConverter.Instance}}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding ThumbnailLoaded}"/>
                                            <TextBlock Text="🎵"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !ThumbnailLoaded}"/>
                                        </Panel>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="1" 
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayArtist}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding DisplayArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                        <TextBlock Text="{Binding Metadata.Duration, Converter={StaticResource SecondsToTime}, FallbackValue=''}"
                                                   IsVisible="{Binding MetadataLoaded}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>

                                    <!-- Context Menu -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add to Playlist (Next)" 
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).AddToPlaylistNextCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Add to Playlist (End)" 
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).AddToPlaylistEndCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Grid Splitter (Left) -->
            <GridSplitter Grid.Column="1"
                          IsVisible="{Binding !IsVideoMode}"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

            <!-- Center Pane: Video Output Area (also used, alone, in Video Mode) -->
            <Border Grid.Column="2"
                    Background="Black"
                    Padding="0">
                <Grid RowDefinitions="*,Auto">
                    <Panel Grid.Row="0" Background="Black">
                        <!-- Waiting screen (nothing playing) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    IsVisible="{Binding IsIdle}">
                            <TextBlock Text="🎤"
                                       FontSize="64"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Waiting for the next song"
                                       Foreground="White"
                                       FontSize="24"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding NextSongInfo, StringFormat='Up next: {0}'}"
                                       Foreground="#CCFFFFFF"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       IsVisible="{Binding HasNextSong}"/>
                        </StackPanel>

                        <!-- Now playing (audio files) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    Margin="24"
                                    IsVisible="{Binding IsAudioContent}">
                            <TextBlock Text="🎵"
                                       FontSize="64"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue=''}"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=''}"
                                       Foreground="#CCFFFFFF"
                                       FontSize="22"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Dual screen: the video is on the playback window -->
                        <Border Background="Black" IsVisible="{Binding IsDualScreenMode}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Margin="24">
                                <TextBlock Text="📺" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="Video is on the second screen"
                                           Foreground="White"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentSongInfo}"
                                           Foreground="#CCFFFFFF"
                                           FontSize="16"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NextSongInfo, StringFormat='Up next: {0}'}"
                                           Foreground="#99FFFFFF"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding HasNextSong}"/>
                                <Button Content="Back to single screen"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Command="{Binding SetSingleScreenModeCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Video surfaces: one native window per LibVLC player (crossfade uses
                             both). They are always in the visual tree so their native handles
                             exist before playback starts; only the active one is visible.
                             Avalonia controls cannot be drawn on top of them. -->
                        <views:EmbeddedVideoView x:Name="VideoViewA"
                                                 IsVisible="{Binding IsVideoSurfaceAVisible}"/>
                        <views:EmbeddedVideoView x:Name="VideoViewB"
                                                 IsVisible="{Binding IsVideoSurfaceBVisible}"/>
                    </Panel>

                    <!-- Collapsible Control Handle at Bottom -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsVideoMode}">
                        <!-- Collapsed Handle (Small Bar) -->
                        <Border x:Name="CollapsedHandle"
                                Height="30"
                                Background="#80000000"
                                IsVisible="{Binding !IsControlHandleExpanded}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock Text="▲"
                                           Foreground="White"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Quick Search &amp; Controls"
                                           Foreground="White"
                                           FontSize="12"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Expanded Handle (Full Controls) -->
                        <Border x:Name="ExpandedHandle"
                                Background="#E0000000"
                                IsVisible="{Binding IsControlHandleExpanded}"
                                Padding="16,12">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                        
                                <!-- Collapse Button -->
                                <Button Grid.Row="0"
                                        Content="▼ Collapse"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CollapseControlHandleCommand}"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Margin="0,0,0,8"/>

                                <!-- Quick Search -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <TextBox Grid.Column="0"
                                             Watermark="Quick Search..."
                                             Text="{Binding VideoModeSearchQuery, Mode=TwoWay}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Content="Search"
                                            Command="{Binding SearchCommand}"
                                            CommandParameter="{Binding VideoModeSearchQuery}"/>
                                </Grid>

                                <!-- Quick Actions -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                                    <Button Content="📋 View Playlist"
                                            Padding="12,6"
                                            Background="#80FFFFFF"
                                            ToolTip.Tip="View current playlist"/>
                                    <Button Content="⚙ Settings"
                                            Padding="12,6"
                                            Background="#80FFFFFF"
                                            ToolTip.Tip="Open settings"/>
                                    <Button Content="Exit Video Mode"
                                            Padding="12,6"
                                            Background="#80FFFFFF"
                                            Command="{Binding ToggleVideoModeCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Grid Splitter (Right) -->
            <GridSplitter Grid.Column="3"
                          IsVisible="{Binding !IsVideoMode}"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>

            <!-- Right Pane: Current Playlist -->
            <Border Grid.Column="4"
                    IsVisible="{Binding !IsVideoMode}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                    BorderThickness="1,0,0,0"
                    Padding="8">
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- Playlist Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Current Playlist"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPlaylist.Count, StringFormat=' ({0})'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>

                    <!-- Playlist Items with Drag-Drop Support (virtualization enabled by default) -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding CurrentPlaylist}"
                             DoubleTapped="OnPlaylistDoubleTapped"
                             SelectedItem="{Binding SelectedPlaylistItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TabIndex="3"
                             IsTabStop="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,80,*,Auto" 
                                      Margin="4"
                                      Background="Transparent">

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Play now"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaySongNowCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Play next"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaySongNextCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Move up"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).MoveSongUpCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Move down"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).MoveSongDownCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Remove"
                                                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RemoveSongCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Queue position (▶ for the song playing) -->
                                    <Panel Grid.Column="0" MinWidth="22" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="▶"
                                                   Foreground="Green"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding IsCurrentlyPlaying}"/>
                                        <TextBlock Text="{Binding PlaylistItem.Position, Converter={x:Static vm:PlusOneConverter.Instance}}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   IsVisible="{Binding !IsCurrentlyPlaying}"/>
                                    </Panel>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="1" 
                                            Width="60" 
                                            Height="45"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                        <Panel>
                                            <Image Source="{Binding MediaFile.ThumbnailPath, Converter={x:Static vm:ThumbnailConverter.Instance}}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding MediaFile.ThumbnailLoaded}"/>
                                            <TextBlock Text="🎵"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !MediaFile.ThumbnailLoaded}"/>
                                        </Panel>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="2" 
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MediaFile.DisplayArtist}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding MediaFile.DisplayArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding MediaFile.DisplayTitle}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                        
                                        <!-- Indicators -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="▶ Now Playing"
                                                       FontSize="10"
                                                       Foreground="Green"
                                                       IsVisible="{Binding IsCurrentlyPlaying}"/>
                                            <TextBlock Text="⚠ Duplicate"
                                                       FontSize="10"
                                                       Foreground="Orange"
                                                       IsVisible="{Binding IsDuplicate}"/>
                                            <TextBlock Text="✕ Error"
                                                       FontSize="10"
                                                       Foreground="Red"
                                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Remove Button -->
                                    <Button Grid.Column="3"
                                            Content="✕"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RemoveSongCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            ToolTip.Tip="Remove from playlist"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Playlist Actions -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                Spacing="4"
                                Margin="0,8,0,0">
                        <Button Content="Clear"
                                Command="{Binding ClearPlaylistCommand}"
                                ToolTip.Tip="Clear all songs from playlist"
                                TabIndex="4"/>
                        <Button Content="Shuffle"
                                Command="{Binding ShufflePlaylistCommand}"
                                ToolTip.Tip="Shuffle playlist order"
                                TabIndex="5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Playback Controls -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowWindowChrome}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Transport Controls -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="⏮"
                            Command="{Binding PreviousCommand}"
                            Width="40"
                            Height="40"
                            FontSize="16"
                            ToolTip.Tip="Previous (Left Arrow)"
                            TabIndex="10"/>
                    <Button Content="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}"
                            Command="{Binding PlayPauseCommand}"
                            Width="50"
                            Height="50"
                            FontSize="20"
                            ToolTip.Tip="Play/Pause (Space)"
                            TabIndex="11"/>
                    <Button Content="⏭"
                            Command="{Binding NextCommand}"
                            Width="40"
                            Height="40"
                            FontSize="16"
                            ToolTip.Tip="Next (Right Arrow)"
                            TabIndex="12"/>
                    <Button Content="⏹"
                            Command="{Binding StopCommand}"
                            Width="40"
                            Height="40"
                            FontSize="16"
                            ToolTip.Tip="Stop (S)"
                            TabIndex="13"/>
                </StackPanel>

                <!-- Progress Bar and Time -->
                <StackPanel Grid.Column="1" 
                            Margin="16,0"
                            VerticalAlignment="Center">
                    <Slider Value="{Binding CurrentTime}"
                            Minimum="0"
                            Maximum="{Binding Duration}"
                            IsEnabled="{Binding IsPlaying}"
                            Margin="0,0,0,4"
                            TabIndex="14"
                            IsTabStop="True"/>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding CurrentTime, Converter={StaticResource SecondsToTime}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Duration, Converter={StaticResource SecondsToTime}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Volume Control -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="⛶"
                            Width="40"
                            Height="40"
                            FontSize="16"
                            ToolTip.Tip="Video Mode on/off (Esc to exit)"
                            Command="{Binding ToggleVideoModeCommand}"
                            TabIndex="14"/>
                    <Button Content="🔊"
                            Width="40"
                            Height="40"
                            FontSize="16"
                            ToolTip.Tip="Mute/Unmute (M)"
                            Command="{Binding ToggleMuteCommand}"
                            TabIndex="15"/>
                    <Slider Value="{Binding Volume}"
                            Minimum="0"
                            Maximum="100"
                            Width="100"
                            VerticalAlignment="Center"
                            TabIndex="16"
                            IsTabStop="True"
                            ToolTip.Tip="Volume (Up/Down Arrows)"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}"
                               VerticalAlignment="Center"
                               MinWidth="40"
                               FontSize="11"
                               IsTabStop="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                IsVisible="{Binding ShowWindowChrome}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="0,1,0,0"
                Padding="16,4"
                Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding CurrentSongInfo}"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🔀"
                               IsVisible="{Binding ShuffleEnabled}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Shuffle enabled"/>
                    <TextBlock Text="🔁"
                               IsVisible="{Binding CrossfadeEnabled}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Crossfade enabled"/>
                    <TextBlock Text="{Binding MediaLibraryCount, StringFormat='📁 {0} files'}"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- Toast Notification Container (Overlay at bottom-right) -->
        <ItemsControl ItemsSource="{Binding NotificationService.Notifications}"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Margin="0,0,16,80">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:ToastNotificationControl NotificationService="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NotificationService}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>

</Window>
