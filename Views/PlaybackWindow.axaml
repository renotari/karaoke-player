<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KaraokePlayer.ViewModels"
        xmlns:views="using:KaraokePlayer.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="KaraokePlayer.Views.PlaybackWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Karaoke Player - Screen"
        Width="1280"
        Height="720"
        Background="Black"
        WindowStartupLocation="Manual">

    <!-- Dual screen: what the audience sees. Same ViewModel as the main window. -->
    <Panel Background="Black">

        <!-- Waiting screen -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    IsVisible="{Binding IsIdle}">
            <TextBlock Text="🎤" FontSize="96" HorizontalAlignment="Center"/>
            <TextBlock Text="Waiting for the next song"
                       Foreground="White"
                       FontSize="40"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding NextSongInfo, StringFormat='Up next: {0}'}"
                       Foreground="#CCFFFFFF"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       IsVisible="{Binding HasNextSong}"/>
        </StackPanel>

        <!-- Audio file: title and artist -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Margin="48"
                    IsVisible="{Binding IsAudioContent}">
            <TextBlock Text="🎵" FontSize="96" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentSong.DisplayTitle, FallbackValue=''}"
                       Foreground="White"
                       FontSize="56"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentSong.DisplayArtist, FallbackValue=''}"
                       Foreground="#CCFFFFFF"
                       FontSize="36"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Video surfaces, one per player (see MainWindow) -->
        <views:EmbeddedVideoView x:Name="VideoViewA" IsVisible="{Binding IsVideoSurfaceAActive}"/>
        <views:EmbeddedVideoView x:Name="VideoViewB" IsVisible="{Binding IsVideoSurfaceBActive}"/>
    </Panel>
</Window>
