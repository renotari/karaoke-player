<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!-- Application Metadata -->
    <AssemblyName>KaraokePlayer</AssemblyName>
    <Product>Karaoke Player</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Karaoke Player</Company>
    <Copyright>Copyright © 2024</Copyright>
    <Description>Professional karaoke and media player with crossfade transitions and dual-screen support</Description>
    
    <!-- Application Icon -->
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    
    <!-- Publishing Configuration -->
    <!-- On Windows the default target is win-x64; on Linux the project builds for the
         host platform (development/testing), unless -r win-x64 is passed explicitly. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <IsWindowsTarget Condition="'$(OS)' == 'Windows_NT' or $(RuntimeIdentifier.StartsWith('win'))">true</IsWindowsTarget>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- The test runner classes have their own Main methods (they are run through Program.Main) -->
    <NoWarn>$(NoWarn);CS8892</NoWarn>
  </PropertyGroup>

  <!-- Windows release settings (self-contained, ReadyToRun) -->
  <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- LibVLC native binaries: the VideoLAN.LibVLC.Windows package copies them to
       libvlc\win-x64 (where LibVLCSharp's Core.Initialize looks). Skip the 32-bit copy.
       On Linux the system libvlc is used. -->
  <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <!-- The LibVLC package collects its files before the build: run it for publish too,
       or a publish with the no-build option leaves libvlc out (the installed app cannot play). -->
  <Target Name="CollectVlcFilesForPublish" Condition="'$(IsWindowsTarget)' == 'true'" BeforeTargets="AssignTargetPaths" DependsOnTargets="CollectVlcFilesToCopyWindows" />

  <!-- Never produce a Windows package without LibVLC -->
  <Target Name="VerifyLibVlcPublished" Condition="'$(IsWindowsTarget)' == 'true'" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)libvlc\win-x64\libvlc.dll')" Text="LibVLC missing from the publish folder ($(PublishDir)libvlc\win-x64\libvlc.dll): the installed app could not play media." />
  </Target>

  <!-- General MIDI SoundFont for .mid/.kar files: GeneralUser GS v2.0.3 by S. Christian Collins
       (free to use and redistribute in software: SoundFonts/GeneralUser-GS-LICENSE.txt).
       32 MB, so not in git: the build downloads it once from a pinned commit of the
       author's GitHub repository, checks it, and copies it next to the app. -->
  <PropertyGroup>
    <SoundFontDir>$(MSBuildProjectDirectory)/SoundFonts</SoundFontDir>
    <SoundFontUrl>https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/97049183643d5fc5a9322a69c5b09efb667c6c3a/GeneralUser-GS.sf2</SoundFontUrl>
    <SoundFontSha256>9575028c7a1f589f5770fccc8cff2734566af40cd26ed836944e9a5152688cfe</SoundFontSha256>
  </PropertyGroup>

  <Target Name="DownloadSoundFont" BeforeTargets="AssignTargetPaths">
    <DownloadFile Condition="!Exists('$(SoundFontDir)/GeneralUser-GS.sf2')" SourceUrl="$(SoundFontUrl)" DestinationFolder="$(SoundFontDir)" Retries="2" />
    <VerifyFileHash File="$(SoundFontDir)/GeneralUser-GS.sf2" Hash="$(SoundFontSha256)" Algorithm="SHA256" />
    <!-- Added here (not statically): on the first build the file did not exist yet -->
    <ItemGroup>
      <None Include="SoundFonts/GeneralUser-GS.sf2" Link="SoundFonts/GeneralUser-GS.sf2"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="SoundFonts/GeneralUser-GS-LICENSE.txt" Link="SoundFonts/GeneralUser-GS-LICENSE.txt"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Never produce a package that cannot play MIDI files -->
  <Target Name="VerifySoundFontPublished" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)SoundFonts/GeneralUser-GS.sf2')" Text="SoundFont missing from the publish folder: .mid/.kar files could not be played." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.4" />
    <PackageReference Include="MeltySynth" Version="2.4.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="ReactiveUI" Version="22.2.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <!-- Linux development: SkiaSharp 3.x does not ship Linux native assets by default -->
  <ItemGroup Condition="'$(IsWindowsTarget)' != 'true'">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
  </ItemGroup>
</Project>
